# Локальные значения. Перед любым нелокальным запуском замените пароли и JWT_SECRET_KEY.

# PostgreSQL
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aegis
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Приложение
APP_PORT=8000
DATABASE_URL=postgresql://aegis:change-me@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate limiting и аудит
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUDIT_LOG_RETENTION_DAYS=90

# Логи и инстанс
LOG_LEVEL=INFO
INSTANCE_ID=instance-1

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
