  <bpmn:process id="Process_IO" name="AEGIS Alpha | 4. Ограниченные повторы операции" isExecutable="false">
    <bpmn:sequenceFlow id="Process_IO_F0" sourceRef="IS" targetRef="Init" name="" />
    <bpmn:sequenceFlow id="Process_IO_F1" sourceRef="Init" targetRef="Attempt" name="" />
    <bpmn:sequenceFlow id="Process_IO_F2" sourceRef="Attempt" targetRef="Result" name="" />
    <bpmn:sequenceFlow id="Process_IO_F3" sourceRef="Result" targetRef="Gi" name="" />
    <bpmn:sequenceFlow id="Process_IO_F4" sourceRef="Gi" targetRef="IE" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_IO_F5" sourceRef="Gi" targetRef="Gretry" name="Нет">
      <bpmn:conditionExpression>Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_IO_F6" sourceRef="Gretry" targetRef="Wait" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_IO_F7" sourceRef="Gretry" targetRef="IF" name="Нет">
      <bpmn:conditionExpression>Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_IO_F8" sourceRef="Wait" targetRef="Attempt" name="Следующая попытка" />
    <bpmn:startEvent id="IS" name="Вызвана операция">
      <bpmn:outgoing>Process_IO_F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Init" name="Установить attempt = 0 и ключ операции">
      <bpmn:incoming>Process_IO_F0</bpmn:incoming>
      <bpmn:outgoing>Process_IO_F1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Attempt" name="Увеличить attempt выполнить операцию">
      <bpmn:incoming>Process_IO_F1</bpmn:incoming>
      <bpmn:outgoing>Process_IO_F2</bpmn:outgoing>
      <bpmn:incoming>Process_IO_F8</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Result" name="Проверить результат и неизвестный исход">
      <bpmn:incoming>Process_IO_F2</bpmn:incoming>
      <bpmn:outgoing>Process_IO_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gi" name="Успех подтверждён?">
      <bpmn:incoming>Process_IO_F3</bpmn:incoming>
      <bpmn:outgoing>Process_IO_F4</bpmn:outgoing>
      <bpmn:outgoing>Process_IO_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="IE" name="SUCCESS">
      <bpmn:incoming>Process_IO_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gretry" name="Можно повторить?">
      <bpmn:incoming>Process_IO_F5</bpmn:incoming>
      <bpmn:outgoing>Process_IO_F6</bpmn:outgoing>
      <bpmn:outgoing>Process_IO_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Wait" name="Подождать 30 секунд">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:incoming>Process_IO_F6</bpmn:incoming>
      <bpmn:outgoing>Process_IO_F8</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="IF" name="FAILURE код + ключ + attempt">
      <bpmn:incoming>Process_IO_F7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
