  <bpmn:process id="Process_Collect" name="AEGIS Alpha | 2. Подпроцесс сбора одного потока" isExecutable="false">
    <bpmn:sequenceFlow id="Process_Collect_F0" sourceRef="CS" targetRef="Fetch" name="" />
    <bpmn:sequenceFlow id="Process_Collect_F1" sourceRef="Fetch" targetRef="Gfetch" name="" />
    <bpmn:sequenceFlow id="Process_Collect_F2" sourceRef="Gfetch" targetRef="Record" name="Да">
      <bpmn:conditionExpression>Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Collect_F3" sourceRef="Gfetch" targetRef="CF" name="Нет">
      <bpmn:conditionExpression>Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Collect_F4" sourceRef="Record" targetRef="Summarize" name="" />
    <bpmn:sequenceFlow id="Process_Collect_F5" sourceRef="Summarize" targetRef="CE" name="" />
    <bpmn:startEvent id="CS" name="Получен контекст потока">
      <bpmn:outgoing>Process_Collect_F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Fetch" name="Получить данные через адаптер" calledElement="Process_IO">
      <bpmn:incoming>Process_Collect_F0</bpmn:incoming>
      <bpmn:outgoing>Process_Collect_F1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gfetch" name="Чтение успешно?">
      <bpmn:incoming>Process_Collect_F1</bpmn:incoming>
      <bpmn:outgoing>Process_Collect_F2</bpmn:outgoing>
      <bpmn:outgoing>Process_Collect_F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Record" name="Проверить и сохранить каждую запись" calledElement="Process_Record">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:incoming>Process_Collect_F2</bpmn:incoming>
      <bpmn:outgoing>Process_Collect_F4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:scriptTask id="Summarize" name="Подсчитать записи и покрытие окна">
      <bpmn:incoming>Process_Collect_F4</bpmn:incoming>
      <bpmn:outgoing>Process_Collect_F5</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="CE" name="Итог потока: OK / PARTIAL / EMPTY">
      <bpmn:incoming>Process_Collect_F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CF" name="Итог потока: UNAVAILABLE">
      <bpmn:incoming>Process_Collect_F3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
