      <bpmn:outgoing>Process_Aegis_F8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gready" name="Пакет полон?">
      <bpmn:incoming>Process_Aegis_F8</bpmn:incoming>
      <bpmn:outgoing>Process_Aegis_F9</bpmn:outgoing>
      <bpmn:outgoing>Process_Aegis_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Manifest" name="Сохранить манифест статус = READY" calledElement="Process_IO">
      <bpmn:incoming>Process_Aegis_F9</bpmn:incoming>
      <bpmn:outgoing>Process_Aegis_F11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gsave" name="Сохранение подтверждено?">
      <bpmn:incoming>Process_Aegis_F11</bpmn:incoming>
      <bpmn:outgoing>Process_Aegis_F12</bpmn:outgoing>
      <bpmn:outgoing>Process_Aegis_F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Ready" name="Датасет готов READY">
      <bpmn:incoming>Process_Aegis_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Partial" name="Сохранить манифест статус = PARTIAL" calledElement="Process_IO">
      <bpmn:incoming>Process_Aegis_F10</bpmn:incoming>
      <bpmn:outgoing>Process_Aegis_F14</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gp" name="Сохранение подтверждено?">
      <bpmn:incoming>Process_Aegis_F14</bpmn:incoming>
      <bpmn:outgoing>Process_Aegis_F15</bpmn:outgoing>
      <bpmn:outgoing>Process_Aegis_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PartialEnd" name="Пакет неполон PARTIAL">
      <bpmn:incoming>Process_Aegis_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Incident" name="Записать диагностику для оператора">
      <bpmn:incoming>Process_Aegis_F3</bpmn:incoming>
      <bpmn:incoming>Process_Aegis_F13</bpmn:incoming>
      <bpmn:incoming>Process_Aegis_F16</bpmn:incoming>
      <bpmn:outgoing>Process_Aegis_F17</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Fail" name="Пакет не готов FAILED">
      <bpmn:incoming>Process_Aegis_F17</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
