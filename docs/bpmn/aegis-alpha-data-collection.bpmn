    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Record_F9" sourceRef="Gq" targetRef="Diag" name="Нет">
      <bpmn:conditionExpression>Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Process_Record_F10" sourceRef="Diag" targetRef="RF" name="" />
    <bpmn:startEvent id="RS" name="Получена запись">
      <bpmn:outgoing>Process_Record_F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Validate" name="Проверить поля и нормализовать">
      <bpmn:incoming>Process_Record_F0</bpmn:incoming>
      <bpmn:outgoing>Process_Record_F1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gvalid" name="Запись валидна?">
      <bpmn:incoming>Process_Record_F1</bpmn:incoming>
      <bpmn:outgoing>Process_Record_F2</bpmn:outgoing>
      <bpmn:outgoing>Process_Record_F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Upsert" name="Выполнить UPSERT по уникальному ключу" calledElement="Process_IO">
      <bpmn:incoming>Process_Record_F2</bpmn:incoming>
      <bpmn:outgoing>Process_Record_F4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gup" name="Запись в БД подтверждена?">
      <bpmn:incoming>Process_Record_F4</bpmn:incoming>
      <bpmn:outgoing>Process_Record_F5</bpmn:outgoing>
      <bpmn:outgoing>Process_Record_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RE" name="SAVED / DUPLICATE / UPDATED">
      <bpmn:incoming>Process_Record_F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Quarantine" name="Сохранить в карантин с причиной" calledElement="Process_IO">
      <bpmn:incoming>Process_Record_F3</bpmn:incoming>
      <bpmn:outgoing>Process_Record_F7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gq" name="Карантин сохранён?">
      <bpmn:incoming>Process_Record_F7</bpmn:incoming>
      <bpmn:outgoing>Process_Record_F8</bpmn:outgoing>
      <bpmn:outgoing>Process_Record_F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RQ" name="QUARANTINED">
      <bpmn:incoming>Process_Record_F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Diag" name="Записать диагностику ключа и ошибки">
      <bpmn:incoming>Process_Record_F6</bpmn:incoming>
      <bpmn:incoming>Process_Record_F9</bpmn:incoming>
      <bpmn:outgoing>Process_Record_F10</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="RF" name="FAILED_RECORD">
      <bpmn:incoming>Process_Record_F10</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
