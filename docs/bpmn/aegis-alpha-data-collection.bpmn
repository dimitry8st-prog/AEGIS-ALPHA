      <bpmn:outgoing>Process_Aegis_F7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="Join" name="Оба потока завершены">
      <bpmn:incoming>Process_Aegis_F6</bpmn:incoming>
