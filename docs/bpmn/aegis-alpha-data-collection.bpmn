      <bpmn:outgoing>Process_Aegis_F4</bpmn:outgoing>
      <bpmn:outgoing>Process_Aegis_F5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="News" name="Собрать новости тип = news" calledElement="Process_Collect">
